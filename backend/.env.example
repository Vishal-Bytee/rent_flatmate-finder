# Server
PORT=5000
NODE_ENV=development
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Database (Neon Postgres connection string)
DATABASE_URL=postgresql://username:password@ep-xxxx.neon.tech/rent_flatmate_finder?sslmode=require

JWT_SECRET=...

GEMINI_API_KEY=...

SMTP_PASS=...
# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# AI - Gemini (free tier). Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Email (Brevo SMTP or Gmail SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Rent & Flatmate Finder <no-reply@rentflatmate.app>"


# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
